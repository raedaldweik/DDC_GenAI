# Copy to .env before building. Values are inlined into the built HTML —
# use restricted/scoped keys only, never a production key.

# --- Claude provider (default) ---
VITE_ANTHROPIC_API_KEY=sk-ant-...
# Optional, defaults to claude-sonnet-5
VITE_CLAUDE_MODEL=claude-sonnet-5

# --- OpenAI-compatible provider (LiteLLM / vLLM / Ollama / TGI) ---
# Setting an endpoint switches the default provider to 'openai'.
# All of these can also be passed per-page as URL params instead:
#   ?endpoint=...&model=...&key=...
# VITE_LLM_PROVIDER=openai
# VITE_LLM_ENDPOINT=https://litellm.internal/v1/chat/completions
